{
  "name": "modern-spf",
  "version": "0.0.1",
  "description": "A modern re-creation of YouTube's SPF (Structured Page Fragments): fast same-origin navigation by fetching only the changed fragments, built on the Navigation API.",
  "keywords": [
    "fragments",
    "navigation",
    "navigation-api",
    "pjax",
    "spf",
    "turbolinks"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "unpkg": "./dist/index.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack src/index.ts --format esm --format cjs --format iife --globalName spf --dts --sourcemap --out-dir dist",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "publint": "publint",
    "attw": "attw --pack .",
    "check:publish": "pnpm build && publint && attw --pack .",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "oxlint": "1.78.0",
    "publint": "0.3.23",
    "semantic-release": "25.0.9",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9",
    "vitepress": "1.6.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0"
}
